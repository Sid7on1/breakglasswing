{
  "name": "bimax",
  "version": "1.0.0",
  "description": "BiMax — Autonomous AI agent for your terminal",
  "bin": {
    "bimax": "bin/bimax.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "start": "node bin/bimax.js",
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x bin/bimax.js",
    "postinstall": "node -e \"try{require('fs').existsSync(require('path').join(process.cwd(),'.breakglass','config.json'))||require('./scripts/postinstall')()}catch(e){}\"",
    "test": "jest --coverage",
    "test:ci": "jest --coverage=false",
    "test:leaks": "jest --coverage=false --detectOpenHandles",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "async-mutex": "^0.5.0",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "cli-spinners": "^3.4.0",
    "commander": "^12.1.0",
    "cron-parser": "^5.5.0",
    "diff": "^4.0.4",
    "dockerode": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "fuzzysort": "^3.1.0",
    "gpt-tokenizer": "^3.4.0",
    "gradient-string": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.5",
    "minimatch": "^10.0.1",
    "openai": "^6.42.0",
    "puppeteer": "^21.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "vscode-jsonrpc": "^9.0.0",
    "web-tree-sitter": "^0.20.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^4.0.2",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.42",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  }
}
