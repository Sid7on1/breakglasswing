.evolution_worktrees/
.env
coverage/
dist/
.breakglass/
src/**/evolve_staging_*
*.backup_*
# Covers node_modules, the node_modules.nosync real dir, AND iCloud conflict-copies like
# "node_modules 2" / "node_modules 10" (note the space) that get spawned on ~/Desktop.
node_modules*
build/

# Runtime logs / crash dumps written to cwd
fatal-crash.log
*.log

# Bundled native engines are fetched/built at runtime, never committed
vendor/*/bin/
vendor/*/cache/
vendor/*/venv/
